#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - git

write_files:
  - path: /opt/placepulse.env
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: __PLACEPULSE_ENV_BASE64__

runcmd:
  - systemctl enable --now docker
  - git clone --depth 1 --branch "__PLACEPULSE_BRANCH__" "__PLACEPULSE_REPOSITORY__" /opt/placepulse
  - install -m 0600 /opt/placepulse.env /opt/placepulse/.env
  - cd /opt/placepulse && docker compose up --build -d


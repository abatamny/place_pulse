# No .env file is required for the default local stack. Copy this file to .env
# only when you want to override one or more values.

# Public web entry point
APP_PORT=8080

# Authentication and optional real SMS delivery
VERIFICATION_SECRET=change-this-for-non-local-use
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TIMEOUT_SECONDS=8

# Internal OpenStreetMap services
OSM_USER_AGENT=PlacePulse-Course-Project/0.1
OVERPASS_URL=http://overpass/api
OVERPASS_PLANET_URL=https://download.geofabrik.de/asia/israel-and-palestine-latest.osm.pbf
OVERPASS_TIMEOUT_SECONDS=20

# AI provider. The default local provider needs no API key.
AI_PROVIDER=local
AI_LOCAL_URL=http://local-ai:8081
AI_TIMEOUT_SECONDS=30

# Local model selection and resource limits
TEXT_SAFETY_MODEL_ID=Qwen/Qwen3Guard-Gen-0.6B
ROUTER_MODEL_ID=Qwen/Qwen3-0.6B
IMAGE_SAFETY_MODEL_ID=OwenElliott/image-safety-classifier-s
LOCAL_AI_DEVICE=auto
LOCAL_AI_MAX_CONCURRENT_INFERENCES=1
IMAGE_UNSAFE_THRESHOLD=0.5

# External provider settings. These are ignored while AI_PROVIDER=local.
AI_API_URL=https://api.openai.com/v1/responses
AI_API_FORMAT=responses
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MODERATION_URL=https://api.openai.com/v1/moderations
AI_MODERATION_MODEL=omni-moderation-latest
AI_MEDIA_MODERATION_MODE=moderations

# Backend admission limits
MAX_REQUEST_BODY_BYTES=11534336
MAX_CONCURRENT_HTTP_REQUESTS=50
MAX_WEBSOCKET_CONNECTIONS=100

# Local PostgreSQL initialization
POSTGRES_DB=placepulse
POSTGRES_USER=placepulse
POSTGRES_PASSWORD=placepulse
